{
	"name": "Atelier Canvas Kit",
	"version": "1.1.0",
	"prefix": "canvas",
	"description": "Machine-readable canonical design tokens. Source of truth for src/styles/_tokens.scss. Guarded by tests/js/tokens.test.mjs.",
	"fonts": {
		"display": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
		"serif": "\"Iowan Old Style\", Palatino, Georgia, serif",
		"mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
		"body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
	},
	"palette": {
		"bg-frame": "#1e1e1e",
		"frame-2": "#2b2b2b",
		"frame-line": "rgba(255, 255, 255, 0.09)",
		"on-dark": "#f0f0f1",
		"on-dark-2": "#a7aaad",
		"on-accent": "#fff",
		"surface": "#fff",
		"surface-tint": "#f7f7f5",
		"surface-muted": "#f6f7f7",
		"surface-code": "#f0f0f1",
		"row-hover": "#fcfcfb",
		"ink": "#1e1e1e",
		"ink-2": "#50575e",
		"ink-3": "#787c82",
		"accent": "#0675c4",
		"accent-hover": "#055d9c",
		"accent-deep": "#044474",
		"accent-tint": "#f0f6fb",
		"accent-line": "#c9e0f2",
		"border": "#dcdcde",
		"border-strong": "#c3c4c7",
		"data-1": "#c7ccd1",
		"data-2": "#dfe3e7",
		"data-3": "#aeb6bf",
		"neutral-tint": "#f1f2f3",
		"hair": "rgba(34, 42, 53, 0.09)",
		"hair-strong": "rgba(34, 42, 53, 0.14)",
		"success": "#00811d",
		"success-tint": "#edf7ee",
		"warning": "#886b00",
		"warning-tint": "#faf3df",
		"error": "#b32d2e",
		"error-tint": "#fcf0f1"
	},
	"color": {
		"ink": { "value": "#1e1e1e", "role": "primary body text" },
		"ink-2": { "value": "#50575e", "role": "secondary text, AA on white" },
		"ink-3": { "value": "#787c82", "role": "tertiary, large or non-essential text only" },
		"accent": { "value": "#0675c4", "role": "primary actions, current selection, the one data series that matters" },
		"accent-tint": { "value": "#f0f6fb", "role": "emphasis fill, live state, selection. Never a left-edge stripe" },
		"surface-tint": { "value": "#f7f7f5", "role": "warm sunken zones, grouped and inset areas" },
		"hair": { "value": "rgba(34, 42, 53, 0.09)", "role": "hairline dividers and rings, replaces #c3c4c7 borders" },
		"data-1": { "value": "#c7ccd1", "role": "monochrome chart series" },
		"data-2": { "value": "#dfe3e7", "role": "monochrome chart series, lighter" },
		"success": { "value": "#00811d", "role": "positive state and upward delta" },
		"warning": { "value": "#886b00", "role": "caution state" },
		"error": { "value": "#b32d2e", "role": "error state" }
	},
	"alias": {
		"radius-lg": "16px",
		"radius": "12px",
		"radius-sm": "8px",
		"radius-pill": "999px",
		"radius-round": "50%",
		"shadow": "0 0 0 1px rgba(34, 42, 53, 0.05), 0 1px 2px rgba(34, 42, 53, 0.04), 0 4px 10px -5px rgba(34, 42, 53, 0.12)",
		"shadow-hi": "0 0 0 1px rgba(34, 42, 53, 0.07), 0 2px 6px rgba(34, 42, 53, 0.05), 0 16px 34px -12px rgba(19, 19, 22, 0.24)",
		"shadow-control": "var(--canvas-shadow)",
		"shadow-card": "var(--canvas-shadow)",
		"shadow-card-hover": "var(--canvas-shadow-hi)",
		"shadow-popover": "var(--canvas-shadow-hi)",
		"space-2xs": "4px",
		"space-xs": "8px",
		"space-sm": "12px",
		"space-md": "16px",
		"space-lg": "24px",
		"space-xl": "32px",
		"space-2xl": "40px",
		"stack-card": "14px",
		"stack-section": "40px",
		"control-h": "40px",
		"sidebar-w": "300px",
		"gutter": "14px",
		"duration-press": "120ms",
		"duration-hover": "160ms",
		"duration-route": "150ms",
		"duration-reveal": "400ms",
		"duration-chart": "650ms",
		"duration-ring": "1100ms",
		"duration-shimmer": "1200ms",
		"duration-reduced": "1ms",
		"ease": "cubic-bezier(0.22, 1, 0.36, 1)",
		"ease-out": "cubic-bezier(0, 0, 0.2, 1)",
		"ease-snap": "cubic-bezier(0.215, 0.61, 0.355, 1)",
		"focus-ring": "color-mix(in srgb, var(--canvas-accent) 34%, transparent)",
		"focus-ring-dark": "rgba(116, 184, 235, 0.72)",
		"page-wash": "linear-gradient(180deg, rgba(217, 236, 249, 0.95) 0%, rgba(232, 243, 251, 0.6) 26%, rgba(240, 246, 251, 0.32) 46%, rgba(255, 255, 255, 0) 74%)"
	}
}
